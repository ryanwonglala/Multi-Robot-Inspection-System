<?xml version="1.0"?>
<sdf version="1.9">
  <model name="large_box">
    <static>true</static>
    <link name="body">
      <!-- Lift the origin to the box base: pose = half-height up -->
      <pose>0 0 0.350 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.6325 0.6325 0.6325</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.6325 0.6325 0.6325</size>
          </box>
        </geometry>
        <material>
          <diffuse>1.0 0.55 0.1 1.0</diffuse>
          <ambient>0.8 0.42 0.08 1.0</ambient>
        </material>
      </visual>
    </link>
  </model>
</sdf>
