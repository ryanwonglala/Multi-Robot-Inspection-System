<?xml version="1.0"?>
<sdf version="1.9">
  <model name="medium_box">
    <static>true</static>
    <link name="body">
      <!-- Lift the origin to the box base: pose = half-height up -->
      <pose>0 0 0.225 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.35 0.35 0.35</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.35 0.35 0.35</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.2 0.85 0.3 1.0</diffuse>
          <ambient>0.15 0.65 0.25 1.0</ambient>
        </material>
      </visual>
    </link>
  </model>
</sdf>
