<?xml version="1.0"?>
<sdf version="1.9">
  <model name="small_box">
    <static>true</static>
    <link name="body">
      <!-- Lift the origin to the box base: pose = half-height up -->
      <pose>0 0 0.125 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.21 0.21 0.21</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box>
            <size>0.21 0.21 0.21</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.2 0.5 1.0 1.0</diffuse>
          <ambient>0.15 0.4 0.8 1.0</ambient>
        </material>
      </visual>
    </link>
  </model>
</sdf>
